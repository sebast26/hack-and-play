# Partner API CODEOWNERS
# https://docs.gitlab.com/ee/user/project/codeowners/
#
# This file defines code ownership for the Partner API platform.
# Reviews are required from the appropriate owners before merging.

# =============================================================================
# DEFAULT OWNERS
# =============================================================================
# Platform team owns everything by default
* @platform-team

# =============================================================================
# GOVERNANCE & CONFIGURATION (Platform Team - Strict Review Required)
# =============================================================================
# These files control what gets exposed to partners and how.
# Changes require platform team review and approval.

# Main governance manifest - controls which services are included
/governance/manifest.yaml @platform-team

# Spec transformation mappings - controls path transformations
/governance/spec-mappings/ @platform-team

# Baseline spec - the "blessed" Partner API contract
/governance/baseline/ @platform-team

# Spectral rules - API design standards
/governance/spectral/ @platform-team

# OpenAPI merge configuration
/governance/openapi-merge.yaml @platform-team

# =============================================================================
# CI/CD & INFRASTRUCTURE (Platform Team)
# =============================================================================
# CI/CD configuration and templates

/.gitlab-ci.yml @platform-team
/ci-templates/ @platform-team
/scripts/ @platform-team
/gateway/ @platform-team
/docker-compose.yml @platform-team

# =============================================================================
# GENERATED FILES (Automated Pipeline)
# =============================================================================
# These files are generated by the aggregation pipeline.
# They should not be manually edited.
# Note: GitLab doesn't support "no owner" so platform team reviews changes
# to ensure they came from the pipeline, not manual edits.

/governance/specs/ @platform-team
/governance/output/ @platform-team

# =============================================================================
# DOCUMENTATION (Platform Team + Contributors)
# =============================================================================
# Documentation can be updated by contributors with platform team review

/docs/ @platform-team

# =============================================================================
# MOCK SERVICES (Individual Teams)
# =============================================================================
# Each team owns their mock service for testing purposes.
# Add team-specific ownership as teams are onboarded.

# Example:
# /mocks/orders/ @orders-team @platform-team
# /mocks/users/ @users-team @platform-team
# /mocks/payments/ @payments-team @platform-team

/mocks/ @platform-team
