{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 3,
  "name": "Partner API Gateway",
  "timeout": "5s",
  "cache_ttl": "0s",
  "output_encoding": "json",
  "port": 8080,
  "plugin": {
    "pattern": ".so",
    "folder": "/opt/krakend/plugins/"
  },
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "plugin/http-server": {
      "name": ["error-status-propagator"],
      "error-status-propagator": {
        "error_key_prefix": "error_",
        "paths": [
          "/partner/order-inventory"
        ]
      }
    }
  },
  "endpoints": [
    {
      "endpoint": "/partner/orders",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v3/orders",
          "host": ["http://orders:8081"],
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/partner/orders/{id}",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v3/orders/{id}",
          "host": ["http://orders:8081"],
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/partner/users",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/users",
          "host": ["http://users:8082"],
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/partner/users/{id}",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/users/{id}",
          "host": ["http://users:8082"],
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/partner/order-inventory",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v3/orders",
          "host": ["http://orders:8081"],
          "encoding": "json",
          "group": "orders"
        },
        {
          "url_pattern": "/api/v1/inventory/check",
          "host": ["http://inventory:8083"],
          "encoding": "json",
          "group": "inventory",
          "extra_config": {
            "backend/http": {
              "return_error_details": "inventory_check"
            }
          }
        }
      ]
    },
    {
      "endpoint": "/partner/inventory/check",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/inventory/check",
          "host": ["http://inventory:8083"],
          "encoding": "json",
          "extra_config": {
            "backend/http": {
              "return_error_code": true
            }
          }
        }
      ]
    }
  ]
}
